#!/usr/bin/env python3
"""Replay loop/events.jsonl → status+attempt; optionally project state.md and decide next action."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from looputil import (  # noqa: E402
    decide,
    final_text,
    load_events,
    loop_status,
    need_human_text,
    parse_tasks,
    project_state_md,
    replay,
)


def _load_parsed(tasks_arg: str | None) -> dict:
    if not tasks_arg:
        return {"name": "", "global_context": "", "tasks": [], "cycle": None, "errors": []}
    p = Path(tasks_arg)
    text = p.read_text(encoding="utf-8")
    stripped = text.lstrip()
    if tasks_arg.endswith(".json") or stripped.startswith("{"):
        data = json.loads(text)
        data.setdefault("tasks", [])
        data.setdefault("cycle", None)
        data.setdefault("errors", [])
        return data
    return parse_tasks(text)


def main() -> int:
    ap = argparse.ArgumentParser(description="Replay min-loop events.jsonl")
    ap.add_argument("events", nargs="?", default="loop/events.jsonl")
    ap.add_argument("--tasks", default="", help="TASKS.md or tasks.json")
    ap.add_argument("--project", default="", help="write projected state.md here")
    ap.add_argument("--decide", action="store_true", help="include next-tick decision")
    ap.add_argument("--ask-json", default="", help="JSON object {id: true} if ASK.md present")
    ap.add_argument("--final-exists", action="store_true")
    args = ap.parse_args()

    events_path = Path(args.events)
    events = load_events(events_path)
    parsed = _load_parsed(args.tasks or None)
    task_ids = [t["id"] for t in parsed["tasks"]]
    replayed = replay(events, task_ids)

    ask_present = {}
    if args.ask_json:
        ask_present = json.loads(args.ask_json)

    out = {
        "has_events": replayed["has_events"],
        "last_seq": replayed["last_seq"],
        "tasks": replayed["tasks"],
        "deleted_done": replayed["deleted_done"],
        "loop_finished": replayed["loop_finished"],
    }

    need = bool(parsed.get("cycle") or parsed.get("errors") or replayed["deleted_done"])
    status = loop_status(parsed, replayed, final_exists=args.final_exists, need_human=need)
    out["loop_state"] = status

    if args.decide:
        decision = decide(
            parsed,
            replayed,
            ask_present=ask_present,
            final_exists=args.final_exists,
        )
        out["decision"] = decision
        if decision["action"] == "need_human":
            out["need_human_md"] = need_human_text(decision["reason"], decision.get("detail"))
            out["loop_state"] = "waiting-human"
        elif decision["action"] == "finished":
            out["final_md"] = final_text(parsed, replayed)
            out["loop_state"] = "finished"

    if args.project:
        Path(args.project).parent.mkdir(parents=True, exist_ok=True)
        Path(args.project).write_text(project_state_md(parsed, replayed, out["loop_state"]), encoding="utf-8")

    json.dump(out, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Parse TASKS.md → JSON. Detects depends_on cycles. Used by run-loop.sh."""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from looputil import find_cycle, parse_tasks  # noqa: E402


def main() -> int:
    path = Path(sys.argv[1] if len(sys.argv) > 1 else "TASKS.md")
    if not path.is_file():
        print(json.dumps({"error": f"missing {path}", "tasks": [], "cycle": None}, ensure_ascii=False))
        return 1
    parsed = parse_tasks(path.read_text(encoding="utf-8"))
    parsed["cycle"] = parsed["cycle"] or find_cycle(parsed["tasks"])
    json.dump(parsed, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    if parsed.get("errors") or parsed.get("cycle"):
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
